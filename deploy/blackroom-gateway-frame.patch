+test("same-origin frames require one exact private allowlisted path", () => {
+  const source = manifest();
+  source.games[0].same_origin_frame_paths = ["/gameframe-release.html"];
+  const result = renderConfigs(source, state, "a".repeat(64));
+  assert.deepEqual(result.gateways.bonk.games[0].same_origin_frame_paths, [
+    "/gameframe-release.html",
+  ]);
+  assert.equal(
+    result.gateways.skribbl.games[0].same_origin_frame_paths,
+    undefined,
+  );
+  assert.equal(result.forum.games[0].same_origin_frame_paths, undefined);
+  source.games[0].same_origin_frame_paths = [];
+  validateManifest(source);
+  for (const paths of [
+    null,
+    "/gameframe-release.html",
+    ["/"],
+    ["/_blackroom/me"],
+    ["/gameframe-release.html/"],
+    ["/gameframe-release.html?x=1"],
+    ["/%67ameframe-release.html"],
+    ["/gameframe-release.html", "/gameframe-release.html"],
+  ]) {
+    source.games[0].same_origin_frame_paths = paths;
+    assert.throws(
+      () => validateManifest(source),
+      /Invalid same-origin frame paths/,
+    );
+  }
+});
